{
  "expo": {
    "name": "VirusTotal",
    "slug": "virus-total",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#13132B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13132B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "navigationBar": {
      "visible": "immersive"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#13132B"
    },
    "newArchEnabled": true,
    "entryPoint": "./App.tsx",
    "plugins": [
      "expo-font"
    ]
  }
}
